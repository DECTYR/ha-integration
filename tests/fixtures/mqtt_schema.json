    "command_set_mqtt_broker": {
      "topic": "dronedetector/217d1a7e7e3ec86a/commands",
      "description": "Commande: enrollment automatique sur un nouveau serveur de gestion (primaire). Le scanner contacte le serveur, attend l'approbation admin, reçoit credentials + CA, les applique et redémarre.",
      "payload": {
        "request_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
        "action": "set_mqtt_broker",
        "params": {
          "host": "gestion.example.com"
        }
      },
      "responses": [
        {
          "status": "success",
          "message": "Enrollment principal démarré vers gestion.example.com (scanner: 217d1a7e7e3ec86a)"
        },
        {
          "status": "success",
          "message": "Enregistrement accepté, en attente d'approbation sur gestion.example.com..."
        },
        {
          "status": "completed",
          "message": "Enrollment principal terminé: mqtt.example.com:8883 (user: scanner-217d). Redémarrage dans 5s..."
        },
        {
