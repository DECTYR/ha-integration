  "issues": {
    "mqtt_required": {
      "title": "MQTT is required for Dectyr RX-5",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Configure MQTT",
            "description": "Open **Settings → Devices & services → Add integration** and set up **MQTT**, or re-enable your existing MQTT entry. When MQTT is loaded, this repair clears automatically."
          }
        },
        "abort": {
          "still_required": "MQTT is still not loaded. After configuring MQTT, submit again."
        }
      }
    },
    "scanner_long_offline": {
      "title": "Scanner offline for more than 24 hours",
      "description": "Scanner {scanner_id} has had no status traffic for over 24 hours while marked offline. Check the scanner connection, power, or remove it if decommissioned."
    },
    "unknown_scanner_publishing": {
      "title": "Unknown scanner publishing telemetry",
      "description": "Scanner {scanner_id} sent drone or error data before reporting an online status. Add this scanner to your network configuration or ignore this MQTT prefix."
    }
  }
